# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres?pgboiler=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres"

# Supabase Auth Keys (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Google Gemini AI API Key (from https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
