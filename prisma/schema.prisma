datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String      @id // Maps directly to Supabase auth.users.id
  email         String      @unique
  name          String
  slug          String      @unique
  avatarUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  portfolio     Portfolio?
}

model Portfolio {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Theme & Customization Engine
  themeId      String      @default("minimal") // "minimal", "modern-creative", "executive", "terminal", "cyberpunk"
  themeConfig  Json?       // { primaryColor: "#3b82f6", font: "Inter", hiddenSections: [], sectionOrder: [...] }
  isPublished  Boolean     @default(true)

  // Profile Header Data
  fullName     String
  headline     String?
  bio          String?
  location     String?
  contactEmail String?
  phone        String?
  website      String?
  availability String?

  // Social Links (Flexible JSON array: [{ platform: "github", url: "..." }])
  socialLinks  Json?

  // Rich Structured Relations
  experiences  Experience[]
  education    Education[]
  skills       Skill[]
  projects     Project[]
  certifications Certification[]
  customSections CustomSection[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Experience {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  company     String
  role        String
  location    String?
  startDate   String
  endDate     String?
  current     Boolean   @default(false)
  description String?
  highlights  Json?     // Bullet points array
  order       Int       @default(0)
}

model Education {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startDate   String?
  endDate     String?
  description String?
  order       Int       @default(0)
}

model Skill {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name        String
  category    String?   // "Languages", "Frameworks", "Tools", etc.
  proficiency Int?
  order       Int       @default(0)
}

model Project {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title       String
  description String?
  techStack   Json?     // Array of tags
  liveUrl     String?
  githubUrl   String?
  imageUrl    String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
}

model Certification {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title       String
  issuer      String
  issueDate   String?
  credentialUrl String?
}

model CustomSection {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title       String
  content     Json
  order       Int       @default(0)
}
